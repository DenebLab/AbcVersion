<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
	  <ImplicitUsings>disable</ImplicitUsings>
	  <Nullable>disable</Nullable>
	  <RootNamespace>Deneblab.AbcVersionCmd</RootNamespace>
	  <AssemblyName>Deneblab.AbcVersionCmd</AssemblyName>
	  <PackAsTool>true</PackAsTool>
	  <ToolCommandName>abcversion</ToolCommandName>
	  <LangVersion>preview</LangVersion>
	  <PublishAot>true</PublishAot>
	  <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
	  <Authors>DenebLab</Authors>
	  <Description>abcversion dotnet tool — calculates semantic versions from Git repository state for use in builds and CI. Also available as a self-contained native binary.</Description>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
	  <PackageProjectUrl>https://github.com/deneblab/abcversion</PackageProjectUrl>
	  <RepositoryUrl>https://github.com/deneblab/abcversion</RepositoryUrl>
	  <RepositoryType>git</RepositoryType>
  </PropertyGroup>
	<ItemGroup>
		<PackageReference Include="NLog.Extensions.Logging" Version="5.3.15" />
		<PackageReference Include="ConsoleAppFramework" Version="5.5.0">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\AbcVersion\AbcVersion.csproj" />
	</ItemGroup>
</Project>
