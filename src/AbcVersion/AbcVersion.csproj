<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework>net8.0</TargetFramework>
	  <ImplicitUsings>disable</ImplicitUsings>
	  <Nullable>disable</Nullable>
	  <RootNamespace>Deneblab.AbcVersion</RootNamespace>
	  <AssemblyName>Deneblab.AbcVersion</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
	  <Authors>DenebLab</Authors>
	  <Description>Semantic versioning library for .NET that calculates versions from Git repository state (branch, first-parent commit count, SHA) using a .abcversion.json config.</Description>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
	  <PackageProjectUrl>https://github.com/deneblab/abcversion</PackageProjectUrl>
	  <PackageReadmeFile>NUGET.md</PackageReadmeFile>
	  <PackageTags>versioning;semver;git;build;msbuild;continuous-integration</PackageTags>
	  <RepositoryUrl>https://github.com/deneblab/abcversion</RepositoryUrl>
	  <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\NUGET.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>

    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.8" />
  </ItemGroup>

</Project>
